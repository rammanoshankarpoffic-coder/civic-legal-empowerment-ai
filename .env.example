# Copy this file to .env and fill in ONE of the options below.
# If you leave everything blank, the backend automatically runs in MOCK
# mode (no network calls, no cost) — the whole demo still works end-to-end.
#
# Priority order the backend checks automatically:
#   1. ANTHROPIC_API_KEY   (paid, best quality)
#   2. GEMINI_API_KEY       (FREE tier — Google AI Studio, recommended for this hackathon)
#   3. GROQ_API_KEY          (FREE tier — fast Llama models, no card needed)
#   4. local Ollama server   (FREE, fully offline)
#   5. mock mode              (FREE, no LLM at all, templated output)

# ---- Option 1: Anthropic Claude (paid) ----
ANTHROPIC_API_KEY=

# ---- Option 2: Google Gemini (FREE tier — recommended, matches OOSC 4.0's
# Google technology focus) ----
# Get a free key at https://aistudio.google.com/apikey — no credit card required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Option 3: Groq (FREE tier) ----
# Sign up free at https://console.groq.com/keys — no credit card required.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Option 4: Ollama (FREE, fully local — no internet needed after setup) ----
# Install from https://ollama.com, then run: ollama pull llama3.1
# The app will auto-detect it running on OLLAMA_HOST below.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Optional: force a specific provider regardless of what's detected ----
# Values: anthropic | gemini | groq | ollama | mock
LLM_PROVIDER=

# Optional
PORT=5000
